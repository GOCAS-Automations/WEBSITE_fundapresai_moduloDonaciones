# Copie este archivo como .env.local y complete los valores. Nunca suba .env.local al repo.

# --- Supabase (Project Settings → API) ---
# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: «anon» (JWT eyJ...) o «publishable» (sb_publishable_...). Funciona con RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: «service_role» (JWT eyJ...) o «secret» (sb_secret_...). SOLO servidor y scripts.
# En la app la usa únicamente /api/heartbeat. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Solo scripts locales (no van a Vercel) ---
# Cadena de conexión Postgres (Connect → Session pooler, puerto 5432). La usa scripts/db-apply.ts.
SUPABASE_DB_URL=
# Token personal de la Management API (sbp_...). Lo usan scripts/gen-types.ts y la configuración de Auth.
SUPABASE_ACCESS_TOKEN=

# --- Sitio ---
# Dominio canónico, sin barra final. En la demo: https://<proyecto>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# «true» solo cuando el subdominio definitivo esté conectado. Mientras sea «false», todo lleva noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Latido (heartbeat) ---
# Secreto largo y aleatorio (p. ej. `openssl rand -hex 32`). Vercel Cron lo envía como Bearer.
CRON_SECRET=
